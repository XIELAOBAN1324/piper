<launch>
  <arg name="master_can_port" default="can0" />
  <arg name="slave_can_port" default="can1" />
  <arg name="bridge_rate_hz" default="200" />
  <arg name="command_timeout_sec" default="0.5" />
  <arg name="auto_enable_slave" default="true" />
  <arg name="follow_gripper" default="true" />
  <arg name="hold_last_joint_on_timeout" default="true" />
  <arg name="go_home_mode2_recover_slave_before_request" default="false" />
  <arg name="go_home_mode2_request_count" default="1" />
  <arg name="go_home_mode2_request_interval_sec" default="0.2" />
  <arg name="go_home_mode2_forward_after_request_sec" default="2.5" />
  <arg name="go_home_mode2_observe_interval_sec" default="0.2" />
  <arg name="go_home_mode2_stop_forward_on_master_standby" default="true" />
  <arg name="shutdown_after_finish" default="true" />
  <arg name="record_enable" default="false" />
  <arg name="record_rate_hz" default="30.0" />
  <arg name="record_slave_pose_topic" default="/piper_dataset/slave_pose_action" />
  <arg name="record_event_topic" default="/piper_dataset/record_event" />

  <node name="piper_master_slave_bridge_node" pkg="piper" type="piper_master_slave_bridge_node.py" output="screen" required="true">
    <param name="master_can_port" value="$(arg master_can_port)" />
    <param name="slave_can_port" value="$(arg slave_can_port)" />
    <param name="bridge_rate_hz" value="$(arg bridge_rate_hz)" />
    <param name="command_timeout_sec" value="$(arg command_timeout_sec)" />
    <param name="auto_enable_slave" value="$(arg auto_enable_slave)" />
    <param name="follow_gripper" value="$(arg follow_gripper)" />
    <param name="hold_last_joint_on_timeout" value="$(arg hold_last_joint_on_timeout)" />
    <param name="go_home_mode2_recover_slave_before_request" value="$(arg go_home_mode2_recover_slave_before_request)" />
    <param name="go_home_mode2_request_count" value="$(arg go_home_mode2_request_count)" />
    <param name="go_home_mode2_request_interval_sec" value="$(arg go_home_mode2_request_interval_sec)" />
    <param name="go_home_mode2_forward_after_request_sec" value="$(arg go_home_mode2_forward_after_request_sec)" />
    <param name="go_home_mode2_observe_interval_sec" value="$(arg go_home_mode2_observe_interval_sec)" />
    <param name="go_home_mode2_stop_forward_on_master_standby" value="$(arg go_home_mode2_stop_forward_on_master_standby)" />
    <param name="shutdown_after_finish" value="$(arg shutdown_after_finish)" />
    <param name="record_enable" value="$(arg record_enable)" />
    <param name="record_rate_hz" value="$(arg record_rate_hz)" />
    <param name="record_slave_pose_topic" value="$(arg record_slave_pose_topic)" />
    <param name="record_event_topic" value="$(arg record_event_topic)" />
  </node>
</launch>
